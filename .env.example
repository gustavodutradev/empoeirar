# ==============================================================================
# Empoeirar — variaveis de ambiente (TEMPLATE)
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NAO e versionado (esta no .gitignore). Este .env.example E.
# Em producao os valores vao no Vercel; segredos idealmente num secret
# manager (Azure Key Vault), nunca no repositorio.
# ==============================================================================

# --- Supabase: variaveis de CLIENTE (expostas ao browser, prefixo NEXT_PUBLIC_) ---

# URL do projeto Supabase. Local (Step 4): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon (publishable). E protegida pela RLS, por isso pode ir ao cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: variavel de SERVIDOR (SEGREDO — nunca exposta) ---

# Chave service_role: BYPASSA a RLS (acesso total). SO no servidor.
# NUNCA prefixe com NEXT_PUBLIC_ e nunca coloque o valor real aqui.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---

# URL canonica do site (SEO / links absolutos). Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
