# ==============================================================================
# Empoeirar — variaveis de ambiente (TEMPLATE)
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NAO e versionado (esta no .gitignore). Este .env.example E.
# Em producao os valores vao no Vercel; segredos idealmente num secret
# manager (Azure Key Vault), nunca no repositorio.
# ==============================================================================

# --- Supabase: variaveis de CLIENTE (expostas ao browser, prefixo NEXT_PUBLIC_) ---

# URL do projeto Supabase. Local (Step 4): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon (publishable). E protegida pela RLS, por isso pode ir ao cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: variavel de SERVIDOR (SEGREDO — nunca exposta) ---

# Chave service_role: BYPASSA a RLS (acesso total). SO no servidor.
# NUNCA prefixe com NEXT_PUBLIC_ e nunca coloque o valor real aqui.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---

# URL canonica do site (SEO / links absolutos). Dev: http://localhost:3000
# Tambem e a base das back_urls e do notification_url do Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago (SEGREDOS — Fase 2, opcionais) ---
# Deixe VAZIO ate a conta do Jane estar pronta: o app roda normal e o checkout
# so nao oferece pagamento. Em producao, no Vercel (env cifrada), nunca no repo.

# Access token de PRODUCAO do Mercado Pago (painel do MP > Suas integracoes).
MERCADOPAGO_ACCESS_TOKEN=

# Segredo da assinatura do webhook (painel do MP > Webhooks). Usado para validar
# que a notificacao (x-signature) veio mesmo do Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Melhor Envio (frete — Fase 2, opcionais) ---
# Sem o token, o checkout mostra "frete a calcular" e segue funcionando.

# Token de acesso do Melhor Envio (SEGREDO). Use o de SANDBOX para testar.
MELHORENVIO_TOKEN=

# "true" (ou vazio) = sandbox; "false" = producao. Comece em sandbox.
MELHORENVIO_SANDBOX=true

# CEP de ORIGEM (de onde a Jane despacha). Enquanto vazio, usa um placeholder
# de BH. Preencher com o CEP real antes de cobrar frete de verdade.
MELHORENVIO_FROM_CEP=
